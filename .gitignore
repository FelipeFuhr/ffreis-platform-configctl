.scannerwork

# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data, such as
# password, private keys, and other secrets. These should not be part of version 
# control as they are data points which are potentially sensitive and subject 
# to change depending on the environment.
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Include tfplan files to ignore the plan output of command: terraform plan -out=tfplan
# example: *tfplan*

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Build output
/bin/platform-configctl
/platform-configctl
dist/

# Go build cache
vendor/
*.test

# Secrets and config — never commit these
.env
.env.*
*.tfvars
*.tfvars.json
secrets.*
*secret*
*credentials*

# ...but Go SOURCE is code, not credentials. `*secret*` above is a filename
# glob, so without these negations every new cmd/secret_*.go is silently
# ignored: `git status` shows nothing, `git add` is a no-op, and the file is
# lost on the next clean checkout. The existing secret_get.go/secret_set.go
# etc. survive only because they were tracked BEFORE that rule landed —
# gitignore never applies to already-tracked files, so the trap is invisible
# until someone adds a NEW one. It cost a full implementation of
# `secret rotate` (1024 lines written, committed as an empty branch).
# Secret CONTENT stays gated by gitleaks (`make secrets-scan`, lefthook
# pre-commit), which is the correct control for this — a filename glob never was.
!*secret*.go
!*credentials*.go

# Backup exports (may contain secrets)
*.backup.json
exports/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test coverage
coverage.out
coverage.html

# Fetched fresh by `make hook-scripts` from ffreis-platform-standards — not
# authored here. Listed individually (not `scripts/hooks/`) so repo-authored
# scripts in the same directory, like check_coverage_gate.sh, can be tracked.
scripts/hooks/check_merge_markers.sh
scripts/hooks/check_large_files.sh
scripts/hooks/check_binary_files.sh
scripts/hooks/check_commit_msg.sh
scripts/hooks/check_required_tools.sh
scripts/bootstrap_lefthook.sh
.bin/
